<?xml version="1.0" ?>
<!--
  DataCenter Sentinel — Gazebo Classic world
  Room: 15m x 10m
  6 server racks in 2 rows (hot aisle / cold aisle layout)
  Robot starts at (0.5, 5.0) facing east (+x)
-->
<sdf version="1.6">
  <world name="datacenter">

    <!-- ========== Physics ========== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ========== Lighting ========== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ambient light (datacenter-like, slightly blue-tinted) -->
    <light name="ambient_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <direction>0.1 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- ========== Ground plane ========== -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ========== Room walls (15m x 10m, 0.2m thick, 3m tall) ========== -->

    <!-- South wall (y=0) -->
    <model name="wall_south">
      <static>true</static>
      <pose>7.5 0.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North wall (y=10) -->
    <model name="wall_north">
      <static>true</static>
      <pose>7.5 9.9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (x=0) -->
    <model name="wall_west">
      <static>true</static>
      <pose>0.1 5.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (x=15) -->
    <model name="wall_east">
      <static>true</static>
      <pose>14.9 5.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.0 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== Server racks — ZONE A (Hot Aisle, y≈7.0) ========== -->
    <!-- Rack dimensions: 0.6m wide x 1.0m deep x 2.0m tall -->
    <!-- Color: dark blue-grey (typical rack color) -->

    <model name="rack_01">
      <static>true</static>
      <pose>3.0 7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_02">
      <static>true</static>
      <pose>6.0 7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_03">
      <static>true</static>
      <pose>9.0 7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== Server racks — ZONE B (Cold Aisle, y≈3.0) ========== -->

    <model name="rack_04">
      <static>true</static>
      <pose>3.0 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_05">
      <static>true</static>
      <pose>6.0 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rack_06">
      <static>true</static>
      <pose>9.0 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 2.0</size></box></geometry>
          <material><ambient>0.15 0.15 0.25 1</ambient><diffuse>0.2 0.2 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== Aisle label markers (thin floor plates) ========== -->

    <model name="label_hot_aisle">
      <static>true</static>
      <pose>6.0 6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>9.0 0.5 0.01</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 0.5</ambient><diffuse>0.8 0.1 0.1 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="label_cold_aisle">
      <static>true</static>
      <pose>6.0 4.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>9.0 0.5 0.01</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 0.5</ambient><diffuse>0.1 0.1 0.8 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========== Gazebo GUI camera position ========== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>7.5 -5.0 12.0 0 0.9 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
